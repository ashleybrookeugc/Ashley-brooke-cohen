# Copy to /etc/oracle-analyzer/analyzer.env during cloud-init.
# This file is not a secret. Tokens live under /etc/oracle-analyzer/secrets/
# and are never written here.

ORACLE_ANALYZER_WEBSITE_REPO=https://github.com/ashleybrookeugc/Ashley-brooke-cohen.git
ORACLE_ANALYZER_WEBSITE_REF=cursor/oracle-analyzer-arm64-22bd
ORACLE_ANALYZER_ANALYZER_REPO=https://github.com/ashleybrookeugc/Ashley-brooke-cohen.git
ORACLE_ANALYZER_ANALYZER_REF=cursor/oss-video-extractors-8f87

ORACLE_ANALYZER_USER=analyzer
ORACLE_ANALYZER_ROOT=/var/lib/oracle-analyzer
ORACLE_ANALYZER_WEBSITE_DIR=/var/lib/oracle-analyzer/website
ORACLE_ANALYZER_ANALYZER_DIR=/var/lib/oracle-analyzer/analyzer
VIDEO_TEST_ROOT=/var/lib/oracle-analyzer/data
VIDEO_ANALYZER_MODULE=/var/lib/oracle-analyzer/analyzer/tools/video-analyzer/core.mjs
HF_HOME=/var/lib/oracle-analyzer/models
PORT=8789

# Corrections backup is off until you follow the runbook.
ORACLE_ANALYZER_BACKUP_ENABLED=0
ORACLE_ANALYZER_BACKUP_REPO=
ORACLE_ANALYZER_BACKUP_BRANCH=main

# Known analyzer-suite failure that must not block a pull update.
# The frozen test still expects the old PocketSphinx engine name.
# Quote this value. The file is sourced by bash, and an unquoted space is a command.
ORACLE_ANALYZER_ALLOWED_TEST_FAILURE='ASR preserves tested connector words and negation with versioned word timestamps'
