{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashley-brooke-cohen",
  "compatibility_date": "2026-09-09",
  "main": "src/router-worker.js",
  "vars": {
    "CONTROL_GITHUB_APP_ID": "4962733",
    "CONTROL_GITHUB_INSTALLATION_ID": "165552010"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "ai": { "binding": "AI" },
  "vpc_services": [{
    "binding": "VIDEO_TEST_PRIVATE_SERVICE",
    "service_id": "01a141ad-d6e8-7ae0-804c-0f98e58320ad"
  }],
  "version_metadata": { "binding": "WORKER_VERSION" },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true }
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "events-production",
    "database_id": "c11e2172-c808-412f-8255-2076490f5646",
    "migrations_dir": "migrations"
  }],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/video-test", "/video-test/*", "/admin", "/admin/*", "/moderation", "/moderation/*", "/control", "/control/*", "/api/*", "/nyfw-pop-ups/event", "/nyfw-pop-ups/event/*", "/nyfw-pop-ups/event.html"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
