{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashley-brooke-cohen",
  "compatibility_date": "2026-09-09",
  "main": "src/router-worker.js",
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "events-production",
    "database_id": "c11e2172-c808-412f-8255-2076490f5646",
    "migrations_dir": "migrations"
  }],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/admin", "/admin/*", "/moderation", "/moderation/*", "/api/*", "/nyfw-pop-ups/event", "/nyfw-pop-ups/event/*", "/nyfw-pop-ups/event.html"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
